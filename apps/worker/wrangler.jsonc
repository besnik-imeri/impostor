{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "impostor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-07",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "impostorgame.com/api/*",
      "zone_name": "impostorgame.com"
    },
    {
      "pattern": "www.impostorgame.com/api/*",
      "zone_name": "impostorgame.com"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://impostorgame.com,https://www.impostorgame.com",
    "ROOM_IDLE_TTL_SECONDS": "86400"
  }
}
