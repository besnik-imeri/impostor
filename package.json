{
  "name": "impostor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @impostor/domain build && corepack pnpm --parallel --filter @impostor/worker --filter @impostor/web dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "corepack pnpm -r --if-present test",
    "test:e2e": "corepack pnpm --filter @impostor/web test:e2e",
    "deploy": "corepack pnpm --filter @impostor/worker deploy && corepack pnpm --filter @impostor/web deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.0"
  }
}
